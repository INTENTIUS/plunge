---
// The home page: ProductHome and the picker. A Starlight page rather than an MDX
// file in the docs collection, so the build bundles no MDX module (whose
// component imports each raise a Vite MODULE_LEVEL_DIRECTIVE warning).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Landing from '../components/Landing.astro';
import ProductHome from '../components/ProductHome.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The release this site documents, read from .plunge-version at the repository root (the build runs in site/).
const version = `v${readFileSync(resolve(process.cwd(), '..', '.plunge-version'), 'utf8').trim()}`;
---
<StarlightPage
	frontmatter={{
		title: 'plunge',
		description: 'Pulumi with per-resource locking.',
		template: 'splash',
		// The site title alone, in place of "plunge | plunge".
		head: [{ tag: 'title', content: 'plunge' }],
	}}
>
	<ProductHome id="plunge" version={version}>
		<img slot="art" class="pl-hero-diver" src={`${base}/brand/plunge-160.png`} width="256" height="256" alt="The plunge diver, a pixel-art cliff diver over the sea" />
	</ProductHome>
	<Landing />
</StarlightPage>
