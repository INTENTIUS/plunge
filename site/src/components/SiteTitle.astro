---
// The site title: the diver and the "plunge" wordmark, linking home. It is drawn
// here rather than through Starlight's `logo` option so the image is a URL
// reference to public/brand/, as on choudoufu's site.
//
// On a phone a Docs link sits beside it: Starlight hides the header's right side
// (where SocialIcons.astro puts Docs) below its md width.
// Adapted from choudoufu's site.
import Diver from './Diver.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title sl-flex">
	<Diver size={32} />
	<span translate="no">plunge</span>
</a>
<a class="pl-docs-phone" href={`${base}/use/start/`}>Docs</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.pl-docs-phone {
		align-self: center;
		margin-left: 0.75rem;
		padding: 0.2rem 0.65rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--pl-rule);
		border-radius: 999px;
		white-space: nowrap;
	}
	@media (min-width: 50rem) {
		.pl-docs-phone {
			display: none;
		}
	}
</style>
