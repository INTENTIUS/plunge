---
// A slot page's links to the same slot on the other platforms: AWS adopt to
// Kubernetes, GCP and Azure adopt. The page's own id decides every side, so a
// slot page gets <PlatformSwitch /> from PageTitle.astro with no props.
const id = Astro.locals.starlightRoute.entry.id;
const [platform, slot] = id.split('/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sides = [
	{ key: 'aws', label: 'AWS' },
	{ key: 'kubernetes', label: 'Kubernetes' },
	{ key: 'gcp', label: 'GCP' },
	{ key: 'azure', label: 'Azure' },
];
// Kubernetes has no proof page: it has no recorded run.
const shown = sides.filter((s) => !(slot === 'proof' && s.key === 'kubernetes'));
---
<p class="pl-switch not-content">
	{shown.map((s) =>
		s.key === platform ? (
			<span aria-current="page">{s.label}</span>
		) : (
			<a href={`${base}/${s.key}/${slot}/`}>{s.label}</a>
		),
	)}
</p>

<style>
	.pl-switch {
		display: inline-flex;
		gap: 0.25rem;
		margin: 1rem 0 0;
		padding: 0.15rem;
		font-size: var(--sl-text-sm);
		border: 1px solid var(--pl-rule);
		border-radius: 0.45rem;
	}
	span,
	a {
		padding: 0.1rem 0.6rem;
		border-radius: 0.3rem;
	}
	span {
		font-weight: 600;
		color: var(--sl-color-black);
		background: var(--pl-accent);
	}
	a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	a:hover {
		color: var(--sl-color-white);
	}
</style>
