---
// Starlight's page title, then the tools for an agent reading the page: a
// "Copy page as Markdown" button (the same text llms-full.txt carries for this
// page) and a pointer to llms.txt. A page's `prompt:` card sits in the footer,
// under the content (Footer.astro). A platform slot page (aws/adopt, gcp/gate, ...) then gets the switch to the
// same slot on the other platforms, so the page itself stays plain Markdown.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PlatformSwitch from './PlatformSwitch.astro';
import { bodyMarkdown, pageMarkdown, pageUrl } from '../markdown';

const { entry } = Astro.locals.starlightRoute;
const body = entry.body ?? '';
// The 404 page (src/pages/404.astro) is no page to copy.
const real = entry.id !== '404' && entry.data.title !== 'Page not found';
const slot = /^(aws|kubernetes|gcp|azure)\/(adopt|gate|operate|compatibility)$/.test(entry.id);
const markdown = pageMarkdown({ title: entry.data.title, url: pageUrl(entry.id), prompt: entry.data.prompt, body: bodyMarkdown(body) });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Default />
{real && (
	<div class="pl-page-tools not-content">
		<button type="button" class="pl-page-copy" data-copy={markdown}>Copy page as Markdown</button>
		<a href={`${base}/llms.txt`}>llms.txt</a>
		<span>lists every page for an agent</span>
	</div>
)}
{slot && <PlatformSwitch />}

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.pl-page-copy')) {
		const label = button.textContent;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Copy failed; use llms-full.txt';
			}
			setTimeout(() => (button.textContent = label), 2000);
		});
	}
</script>

<style>
	.pl-page-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.6rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	button {
		font: inherit;
		font-weight: 500;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--pl-rule);
		border-radius: 0.4rem;
		padding: 0.2rem 0.7rem;
		cursor: pointer;
	}
	button:hover {
		border-color: var(--pl-accent);
	}
	a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
	}
	/* On a phone the llms.txt link stands alone, without its note. */
	@media (max-width: 40rem) {
		span {
			display: none;
		}
	}
</style>
