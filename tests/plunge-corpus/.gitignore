# Dependencies and build output for the corpus programs. Lock files
# (package-lock.json, go.sum, packages.lock.json) are kept.
node_modules/
bin/
obj/
venv/
.venv/
__pycache__/
*.pyc
# The repo root ignores package-lock.json; the corpus keeps it so a
# baseline names the exact dependency tree it ran with.
!package-lock.json
# Local file backends and baseline scratch, if pointed inside the tree.
.pulumi/
state/
